# Frontend: absolute origin of the compress API for split deployments.
# Leave blank in development; Vite proxies /api to localhost:8787.
VITE_API_BASE_URL=

# API: port for the compress server and the built frontend.
PORT=8787

# API: comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
