{
  "name": "pdfresizer",
  "private": true,
  "version": "1.0.0",
  "description": "Sheet — a local-first PDF workshop with compress, resize, merge, split, rotate, and reorder.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarvkk/pdfresizer.git"
  },
  "homepage": "https://github.com/sarvkk/pdfresizer#readme",
  "bugs": {
    "url": "https://github.com/sarvkk/pdfresizer/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test tests/*.test.ts",
    "start:api": "tsx server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "hono": "^4.12.28",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
